meta {
  name: 02 - Listar Productos
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/productos?pagina=0&tamano=20
  body: none
  auth: none
}

params:query {
  pagina: 0
  tamano: 20
}

assert {
  res.status: eq 200
}

docs {
  Lista productos de forma paginada (orden por nombre ascendente).
  Corre "01 - Crear Producto" primero para tener al menos un registro.

  Query params opcionales: `pagina` (default 0) y `tamano` (default 20,
  maximo 100). La respuesta viene envuelta:
  { "contenido": [...], "pagina": 0, "tamano": 20, "totalElementos": N, "totalPaginas": N }
}
